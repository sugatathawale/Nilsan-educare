# ─────────────────────────────────────────────
# Nilsan Educare — Backend environment
# Copy to .env and fill in real values:
#   cp .env.example .env
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# ── Neon PostgreSQL (REQUIRED) ───────────────
# Neon dashboard → your project → Connection details → Connection string
# Use the "pooled" URI for the app (port 5432 with -pooler host is fine)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-long-random-secret-at-least-16-chars"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="nilsan_auth_token"

# Admin login (used by /admin/login)
ADMIN_EMAIL="admin@nilsaneducare.com"
ADMIN_PASSWORD="admin123"

# ── Razorpay (optional until payments go live) ─
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Bunny Stream (REQUIRED for video upload) ─
# bunny.net → Stream → create Library → API
# Library ID: number shown on the library page
BUNNY_STREAM_LIBRARY_ID=""
# API key: Stream → API → Video Library API Key (AccessKey)
BUNNY_STREAM_API_KEY=""
# CDN hostname from library details, e.g. vz-abc123.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=""
